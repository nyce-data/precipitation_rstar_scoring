{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rstar-assessment.schema.json",
  "title": "R* assessment saved by the R* categorization viewer",
  "description": "The colleague's R* form format (rstar-pipeline/input/framework/assessment-form/example_rstar_json.json) with one added block, \"assessor\". A score of NA is saved as null, and so is any total, contribution, composite score or tier that depends on it.",
  "type": "object",
  "required": ["assessmentTimestamp", "dataset", "primaryDataCurator", "assessor", "rStarCompositeScore",
               "triageTier", "formula", "components", "framework"],
  "properties": {
    "assessmentTimestamp": { "type": "string", "format": "date-time", "description": "When Save was pressed, UTC." },
    "dataset": {
      "type": "object",
      "required": ["name", "identifier"],
      "properties": {
        "name": { "type": "string" },
        "identifier": { "type": "string", "description": "The DOI, or a data endpoint URL when there is no DOI." }
      }
    },
    "primaryDataCurator": {
      "type": "object",
      "required": ["name", "email"],
      "properties": { "name": { "type": "string" }, "email": { "type": "string" } }
    },
    "assessor": {
      "type": "object",
      "description": "Added to the colleague's format: who chose the scores.",
      "required": ["name", "email", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "role": { "enum": ["", "expert", "workshop_participant", "workshop_group"] }
      }
    },
    "rStarCompositeScore": { "type": ["number", "null"] },
    "triageTier": { "enum": ["Mirror now", "Stabilize and mirror", "Monitor", null] },
    "formula": { "type": "string" },
    "components": {
      "type": "object",
      "required": ["D", "P", "RRS", "DIRS"],
      "properties": {
        "D": { "$ref": "#/$defs/component" },
        "P": { "$ref": "#/$defs/component" },
        "RRS": { "$ref": "#/$defs/component" },
        "DIRS": { "$ref": "#/$defs/component" }
      }
    },
    "framework": { "type": "object" }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["label", "definition", "rawScore", "weight", "weightedContribution", "scoringMethod",
                   "justification", "factors"],
      "properties": {
        "label": { "type": "string" },
        "definition": { "type": "string" },
        "rawScore": { "type": ["number", "null"] },
        "weight": { "type": "number" },
        "weightedContribution": { "type": ["number", "null"] },
        "scoringMethod": { "type": "string", "description": "Left empty by the viewer." },
        "justification": { "type": "string", "description": "The scorer's notes, one line per subcategory: \"P-1: ...\"." },
        "factors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["condition", "present", "points", "maxPoints"],
            "properties": {
              "condition": { "type": "string" },
              "present": { "type": ["boolean", "null"], "description": "true = full points, false = 0, null = NA." },
              "points": { "type": ["number", "null"] },
              "maxPoints": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
